# =============================================================================
# Example environment file
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# .env is listed in .gitignore, so your real keys stay out of git.
# Never commit real keys to .env.example.
# Lines that start with # are comments and are ignored.
# =============================================================================


# -----------------------------------------------------------------------------
# OpenAI (REQUIRED)
# The solution uses OpenAI for embeddings and chat. Get a key at
# https://platform.openai.com/api-keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key-here

# Optional: the chat model used by aisolution/solution.py and tools/debug.py.
# Default: gpt-4.1-mini
# OPENAI_CHAT_MODEL=gpt-4.1-mini

# Optional: the embedding model used to build the Chroma index.
# Default: text-embedding-3-small
# Changing it makes the solution rebuild the index on the next run.
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small


# -----------------------------------------------------------------------------
# LangSmith (OPTIONAL - tracing and observability)
# Uncomment these to send traces to LangSmith. Get a key at
# https://smith.langchain.com  (Settings -> API Keys)
# -----------------------------------------------------------------------------
# LANGSMITH_API_KEY=lsv2_your-langsmith-key-here
# LANGSMITH_AGENT_ID=your-agent-id-here
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_AGENT_ENVIRONMENT=production


# -----------------------------------------------------------------------------
# Ragas evaluation (OPTIONAL - used by aisolution/ragas.py)
# -----------------------------------------------------------------------------
# Model Ragas uses for grading. Default: gpt-4.1-mini
# RAGAS_LLM_MODEL=gpt-4.1-mini

# Which metrics to compute: a comma-separated list of metric names, or
# "all" / "none". Default: none
# RAGAS_METRICS=none


